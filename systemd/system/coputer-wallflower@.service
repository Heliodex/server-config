[Unit]
Description=Coputer wallflower node %i
Documentation=https://github.com/Heliodex/coputer
After=network-online.target
Wants=network-online.target


# Do not spin if the service cannot start.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=heliodex
Group=heliodex
WorkingDirectory=/home/heliodex/coputer/wallflower
ExecStart=/usr/bin/wallflower start
Restart=always
RestartSec=10
TimeoutStopSec=20
Slice=apps.slice

# The node's identity: cosec (secret key), peers, programs.
ReadWritePaths=/home/heliodex/coputer/wallflower

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
